{
  "name": "learnix-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "precommit": "pnpm format && turbo lint typecheck test build --force"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@vercel/node": "^20.0.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "pnpm --filter @repo/web eslint --max-warnings=0"
    ],
    "apps/api/src/**/*.ts": [
      "pnpm --filter @repo/api eslint --max-warnings=0 --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
